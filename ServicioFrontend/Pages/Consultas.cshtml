@page
@model ConsultasModel
@{
    ViewData["Title"] = "Consultas - SAT";
}

<div class="text-center mb-4">
    <h1 class="display-4">Módulo de Consultas y Reportes</h1>
    <p class="text-muted">Consulta de facturas emitidas o recibidas registradas en el sistema.</p>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card p-4 shadow-sm border-0 bg-light">
            <h5 class="card-title mb-3">Parámetros de Búsqueda</h5>
            <form method="post">
                <div class="form-group mb-3">
                    <label for="Nit" class="form-label"><strong>NIT del Contribuyente:</strong></label>
                    <input asp-for="Nit" class="form-control" placeholder="Ej. 7378106" />
                </div>

                <div class="form-group mb-3">
                    <label for="Tipo" class="form-label"><strong>Tipo de Consulta:</strong></label>
                    <select asp-for="Tipo" class="form-select">
                        <option value="emitidas">Facturas Emitidas</option>
                        <option value="recibidas">Facturas Recibidas</option>
                    </select>
                </div>

                <button type="submit" asp-page-handler="Consultar" class="btn btn-primary w-100 fw-bold">
                    🔍 Buscar Facturas
                </button>
            </form>
        </div>
    </div>

    <div class="col-md-8">
        <h5 class="mb-3">Resultados de la Consulta</h5>

        @if (!string.IsNullOrEmpty(Model.MensajeError))
        {
            <div class="alert alert-warning" role="alert">
                @Model.MensajeError
            </div>
        }
        else if (Model.BusquedaRealizada)
        {
            @if (Model.ListaFacturas.Count > 0)
            {
                <div class="table-responsive card shadow-sm border-0">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Fecha / Tiempo</th>
                                <th>Referencia</th>
                                <th>NIT Emisor</th>
                                <th>NIT Receptor</th>
                                <th class="text-end">Valor</th>
                                <th class="text-end">IVA</th>
                                <th class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var factura in Model.ListaFacturas)
                            {
                                <tr>
                                    <td><small>@factura.Tiempo</small></td>
                                    <td><span class="badge bg-secondary">@factura.Referencia</span></td>
                                    <td>@factura.NitEmisor</td>
                                    <td>@factura.NitReceptor</td>
                                    <td class="text-end">Q @factura.Valor.ToString("N2")</td>
                                    <td class="text-end">Q @factura.Iva.ToString("N2")</td>
                                    <td class="text-end fw-bold">Q @factura.Total.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info" role="alert">
                    No se encontraron facturas @Model.Tipo para el NIT <strong>@Model.Nit</strong>.
                </div>
            }
        }
        else
        {
            <div class="card p-4 text-center text-muted border-0 bg-light">
                <p class="mb-0">Ingresa un NIT y selecciona el tipo de consulta para ver los registros.</p>
            </div>
        }
    </div>
</div>