@page
@model IndexModel
@{
    ViewData["Title"] = "Simulador SAT - Frontend";
}

<div class="text-center">
    <h1 class="display-4">Simulador de DTE y RTU - SAT</h1>
    <p>Gestiona el envío de tus solicitudes hacia la API del Servicio 2.</p>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <form method="post">
            <div class="form-group">
                <label for="JsonInput"><strong>Pega aquí tu mensaje en formato JSON:</strong></label>
                <textarea asp-for="JsonInput" class="form-control" rows="10" placeholder='Ej. [{"NIT": "7378106", "nombre": "Empresa ABC, S.A."}]'></textarea>
            </div>
            
            <div class="mt-3">
                <button type="submit" asp-page-handler="ActualizarRtu" class="btn btn-primary">Actualizar RTU</button>
                <button type="submit" asp-page-handler="ProcesarFacturas" class="btn btn-success">Procesar Facturas (DTE)</button>
<!-- El botón rojo ahora está dentro del form -->
<button type="submit" asp-page-handler="Inicializar" class="btn btn-danger">Inicializar (Resetear)</button>
            </div>
        </form>
    </div>

    <div class="col-md-6">
        <h4>Respuesta de la API:</h4>
        <div class="card bg-light p-3">
            <pre><code>@Model.ResultadoApi</code></pre>
        </div>
    </div>
</div>