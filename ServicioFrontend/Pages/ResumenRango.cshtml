@page
@model ResumenRangoModel
@{
    ViewData["Title"] = "Resumen por Rango";
}

<div class="text-center mb-4">
    <h1 class="display-4">Resumen por Rango de Fechas</h1>
    <p class="text-muted">Consulta de valores totales o sin IVA agrupados por fecha.</p>
</div>

<div class="row">
    <div class="col-md-4 mb-4">
        <div class="card p-4 shadow-sm border-0 bg-light">
            <h5 class="card-title mb-3">Parámetros del Rango</h5>
            <form method="post">
                <div class="mb-3">
                    <label for="FechaInicio" class="form-label"><strong>Fecha Inicio:</strong></label>
                    <input asp-for="FechaInicio" class="form-control" placeholder="Ej. 01/01/2025" />
                </div>
                <div class="mb-3">
                    <label for="FechaFin" class="form-label"><strong>Fecha Fin:</strong></label>
                    <input asp-for="FechaFin" class="form-control" placeholder="Ej. 31/12/2025" />
                </div>
                <div class="mb-3">
                    <label for="Modo" class="form-label"><strong>Tipo de Valor:</strong></label>
                    <select asp-for="Modo" class="form-select">
                        <option value="total">Valores Totales (Con IVA)</option>
                        <option value="siniva">Valores Sin IVA</option>
                    </select>
                </div>
                <button type="submit" asp-page-handler="Consultar" class="btn btn-primary w-100 fw-bold mb-2">
                     Generar Resumen Rango
                </button>
            </form>
            @if (Model.ListaRango.Count > 0)
            {
                <button onclick="window.print();" class="btn btn-outline-secondary w-100 fw-bold mt-2">
                     Exportar / Imprimir PDF
                </button>
            }
        </div>
    </div>

    <div class="col-md-8">
        <h5 class="mb-3">Resultados por Fecha</h5>

        @if (!string.IsNullOrEmpty(Model.MensajeError))
        {
            <div class="alert alert-warning">@Model.MensajeError</div>
        }
        else if (Model.BusquedaRealizada)
        {
            @if (Model.ListaRango.Count > 0)
            {
                <!-- Gráfica de Líneas/Tendencia -->
                <div class="card p-3 shadow-sm border-0 mb-4">
                    <canvas id="graficaRango" style="max-height: 300px;"></canvas>
                </div>

                <div class="table-responsive card shadow-sm border-0">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>Fecha</th>
                                <th class="text-center">Cantidad de Facturas</th>
                                <th class="text-end">Monto (@Model.Modo.ToUpper())</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.ListaRango)
                            {
                                <tr>
                                    <td><span class="badge bg-secondary">@item.Fecha</span></td>
                                    <td class="text-center">@item.CantidadFacturas</td>
                                    <td class="text-end fw-bold text-primary">Q @item.Monto.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @section Scripts {
                    <script>
                        const ctxRango = document.getElementById('graficaRango').getContext('2d');
                        const fechas = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ListaRango.Select(x => x.Fecha)));
                        const montos = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ListaRango.Select(x => x.Monto)));

                        new Chart(ctxRango, {
                            type: 'line',
                            data: {
                                labels: fechas,
                                datasets: [{
                                    label: 'Monto @Model.Modo.ToUpper() (Q)',
                                    data: montos,
                                    backgroundColor: 'rgba(13, 110, 253, 0.2)',
                                    borderColor: 'rgba(13, 110, 253, 1)',
                                    borderWidth: 2,
                                    tension: 0.2,
                                    fill: true
                                }]
                            },
                            options: {
                                responsive: true,
                                scales: {
                                    y: { beginAtZero: true }
                                }
                            }
                        });
                    </script>
                }
            }
            else
            {
                <div class="alert alert-info">
                    No se encontraron registros en el rango de fechas proporcionado.
                </div>
            }
        }
        else
        {
            <div class="card p-4 text-center text-muted border-0 bg-light">
                <p class="mb-0">Configura el rango de fechas y el tipo de valor para ver el reporte y su gráfica de tendencia.</p>
            </div>
        }
    </div>
</div>